<UserControl x:Class="ATSA.UI.UCtrls.UCXChannelStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ATSA.UI.UCtrls"
             xmlns:models="clr-namespace:ATSA.UI.Models"
             xmlns:conv="clr-namespace:ATSA.UI.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=models:XChannelStatus, IsDesignTimeCreatable=False}"
             d:DesignHeight="100" d:DesignWidth="600">

    <UserControl.Resources>
        <conv:ChannelStatusToColorConverter x:Key="ChannelStatusToColorConverter"/>
    </UserControl.Resources>
    
    <Border BorderBrush="{StaticResource Color.Border}" BorderThickness="0,0,0,1" 
            Background="{Binding Path=., Converter={StaticResource ChannelStatusToColorConverter}}" 
            Padding="12,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>  <!-- CNO -->
                <ColumnDefinition Width="100"/> <!-- NAME -->
                <ColumnDefinition Width="*"/>   <!-- STATS -->
            </Grid.ColumnDefinitions>

            <!-- 1. CNO & NAME -->
            <TextBlock Grid.Column="0" Text="{Binding CNO}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Foreground="#555"/>
            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>

            <!-- 2. STATS GRID -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- BUY ROW -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="2" Padding="4,1" Margin="0,0,8,0" Width="40">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#2196F3"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TotalBuyCount}" Value="0">
                                        <Setter Property="Background" Value="#E0E0E0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="BUY" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>
                    
                    <TextBlock Text="Orders:" Foreground="Gray" FontSize="11" Width="45"/>
                    <TextBlock Text="{Binding BuyOrderCount, StringFormat=D2}" FontWeight="Bold" Width="25" TextAlignment="Right"/>
                    <TextBlock Text="{Binding BuyOrderLot, StringFormat=N2}" Foreground="#2196F3" Width="45" TextAlignment="Right" Margin="4,0,0,0"/>
                    
                    <Separator Width="1" Background="#EEE" Margin="12,2"/>

                    <TextBlock Text="Positions:" Foreground="Gray" FontSize="11" Width="55"/>
                    <TextBlock Text="{Binding BuyPositionCount, StringFormat=D2}" FontWeight="Bold" Width="25" TextAlignment="Right"/>
                    <TextBlock Text="{Binding BuyPositionLot, StringFormat=N2}" Foreground="#2196F3" Width="45" TextAlignment="Right" Margin="4,0,0,0"/>

                    <Separator Width="1" Background="#EEE" Margin="12,2"/>

                    <TextBlock Text="Total:" Foreground="Gray" FontSize="11" Width="35"/>
                    <TextBlock Text="{Binding BuyTotalLot, StringFormat=N2}" FontWeight="ExtraBold" Foreground="#1565C0" Width="50" TextAlignment="Right"/>
                </StackPanel>

                <!-- SELL ROW -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                    <Border CornerRadius="2" Padding="4,1" Margin="0,0,8,0" Width="40">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#F44336"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TotalSellCount}" Value="0">
                                        <Setter Property="Background" Value="#E0E0E0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="SELL" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Orders:" Foreground="Gray" FontSize="11" Width="45"/>
                    <TextBlock Text="{Binding SellOrderCount, StringFormat=D2}" FontWeight="Bold" Width="25" TextAlignment="Right"/>
                    <TextBlock Text="{Binding SellOrderLot, StringFormat=N2}" Foreground="#F44336" Width="45" TextAlignment="Right" Margin="4,0,0,0"/>

                    <Separator Width="1" Background="#EEE" Margin="12,2"/>

                    <TextBlock Text="Positions:" Foreground="Gray" FontSize="11" Width="55"/>
                    <TextBlock Text="{Binding SellPositionCount, StringFormat=D2}" FontWeight="Bold" Width="25" TextAlignment="Right"/>
                    <TextBlock Text="{Binding SellPositionLot, StringFormat=N2}" Foreground="#F44336" Width="45" TextAlignment="Right" Margin="4,0,0,0"/>

                    <Separator Width="1" Background="#EEE" Margin="12,2"/>

                    <TextBlock Text="Total:" Foreground="Gray" FontSize="11" Width="35"/>
                    <TextBlock Text="{Binding SellTotalLot, StringFormat=N2}" FontWeight="ExtraBold" Foreground="#C62828" Width="50" TextAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
