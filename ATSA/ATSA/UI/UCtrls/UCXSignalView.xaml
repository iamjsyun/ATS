<UserControl x:Class="ATSA.UI.UCtrls.UCXSignalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:uc="clr-namespace:ATSA.UI.UCtrls"
             xmlns:conv="clr-namespace:ATSA.UI.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=uc:UCXSignalViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="400" d:DesignWidth="800">
    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <conv:IntentToColorConverter x:Key="IntentToColorConverter"/>
    </UserControl.Resources>
    <Border BorderBrush="{StaticResource Color.Border}" BorderThickness="1" CornerRadius="4" Background="White" Margin="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            
            <DataGrid Grid.Row="1" 
                      ItemsSource="{Binding Signals}" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      BorderThickness="0"
                      FontSize="11"
                      RowHeaderWidth="0"
                      GridLinesVisibility="None"
                      Background="Transparent"
                      RowDetailsVisibilityMode="Visible">
                <DataGrid.Resources>
                    <!-- [v9.6] 카드 타입 로우 스타일 정의 -->
                    <Style TargetType="DataGridRow">
                        <Setter Property="Margin" Value="4,2,4,6"/>
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="SnapsToDevicePixels" Value="true"/>
                        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type DataGridRow}">
                                    <Border x:Name="DGR_Border"
                                            BorderThickness="4,1,1,1"
                                            CornerRadius="3"
                                            Background="{TemplateBinding Background}"
                                            Margin="{TemplateBinding Margin}">
                                        <!-- 좌측 마크 라인 색상 트리거 -->
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding dir}" Value="1">
                                                        <Setter Property="BorderBrush" Value="#2196F3"/> <!-- BUY: Blue -->
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding dir}" Value="2">
                                                        <Setter Property="BorderBrush" Value="#F44336"/> <!-- SELL: Red -->
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <!-- 1행: 데이터 셀 -->
                                            <DataGridCellsPresenter Grid.Row="0" ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                            
                                            <!-- 2행: 상세 정보 (Status + Msg) -->
                                            <ContentPresenter Grid.Row="1" 
                                                              Content="{TemplateBinding DetailsVisibility}" 
                                                              ContentTemplate="{TemplateBinding DetailsTemplate}" 
                                                              Visibility="{TemplateBinding DetailsVisibility}"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="DGR_Border" Property="Background" Value="#F0F7FF"/>
                                            <Setter TargetName="DGR_Border" Property="BorderBrush" Value="#2196F3"/>
                                            <Setter Property="Foreground" Value="Black"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="CenterAlignStyle" TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                    </Style>
                    <Style x:Key="RightAlignStyle" TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Right"/>
                        <Setter Property="Margin" Value="0,0,6,0"/>
                    </Style>
                </DataGrid.Resources>

                <!-- 상세 행 템플릿: 2행 구성 (Status Code:Name + Message) -->
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border Background="#FAFAFA" Padding="32,4,12,8" BorderBrush="#F0F0F0" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- Status Badge (Code:Name) -->
                                    <ColumnDefinition Width="Auto"/> <!-- Separator -->
                                    <ColumnDefinition Width="*"/>    <!-- Message -->
                                </Grid.ColumnDefinitions>

                                <!-- 상태 코드와 명칭을 동시에 표현 (v9.0 요구사항 준수) -->
                                <Border Grid.Column="0" 
                                        Background="{Binding xe_status, Converter={StaticResource StatusToColorConverter}}" 
                                        CornerRadius="2" Padding="6,1" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding SelectedXEStatus}" 
                                               Foreground="White" 
                                               TextAlignment="Center" 
                                               FontWeight="Bold" 
                                               FontSize="10"/>
                                </Border>

                                <TextBlock Grid.Column="1" Text=" ┗ " Foreground="#CCC" FontWeight="Bold" Margin="4,0,4,0" VerticalAlignment="Top"/>
                                
                                <TextBlock Grid.Column="2" 
                                           Text="{Binding xe_status_msg}" 
                                           FontSize="10.5" 
                                           FontStyle="Italic" 
                                           Foreground="#666" 
                                           TextWrapping="Wrap" 
                                           VerticalAlignment="Top"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>

                <DataGrid.Columns>
                    <!-- [v9.6] Line 1: Trading Data (SID, Symbol, Dir, Type, Price, LotT, Lot, TE, TS, SL, TP, XA:EN, XA:EX) -->
                    <DataGridTextColumn Header="SID" Binding="{Binding sid}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Margin" Value="6,0,0,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Symbol" Binding="{Binding symbol}" Width="55" ElementStyle="{StaticResource CenterAlignStyle}"/>

                    <DataGridTemplateColumn Header="Dir" Width="45">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SelectedDir}" TextAlignment="Center" FontWeight="Bold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding dir}" Value="1"><Setter Property="Foreground" Value="#2196F3"/></DataTrigger>
                                                <DataTrigger Binding="{Binding dir}" Value="2"><Setter Property="Foreground" Value="#F44336"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Type" Binding="{Binding SelectedType}" Width="60" ElementStyle="{StaticResource CenterAlignStyle}"/>
                    
                    <DataGridTextColumn Header="Price" Binding="{Binding price_signal, StringFormat=N2}" Width="65" ElementStyle="{StaticResource RightAlignStyle}"/>
                    <DataGridTextColumn Header="LotT" Binding="{Binding SelectedLotType}" Width="70" ElementStyle="{StaticResource CenterAlignStyle}"/>
                    <DataGridTextColumn Header="Lot" Binding="{Binding lot, StringFormat=N2}" Width="45" ElementStyle="{StaticResource RightAlignStyle}"/>

                    <DataGridTextColumn Header="TE" Binding="{Binding te_start, StringFormat=N0}" Width="35" ElementStyle="{StaticResource RightAlignStyle}"/>
                    <DataGridTextColumn Header="TS" Binding="{Binding ts_start, StringFormat=N0}" Width="35" ElementStyle="{StaticResource RightAlignStyle}"/>
                    <DataGridTextColumn Header="SL" Binding="{Binding sl, StringFormat=N0}" Width="45" ElementStyle="{StaticResource RightAlignStyle}"/>
                    <DataGridTextColumn Header="TP" Binding="{Binding tp, StringFormat=N0}" Width="45" ElementStyle="{StaticResource RightAlignStyle}"/>

                    <DataGridTemplateColumn Header="XA:EN" Width="55">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding xa_entry, Converter={StaticResource IntentToColorConverter}}" 
                                        CornerRadius="2" Padding="4,1" Margin="4,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedXAEntry}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="XA:EX" Width="75">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding xa_exit, Converter={StaticResource IntentToColorConverter}}" 
                                        CornerRadius="2" Padding="4,1" Margin="4,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedXAExit}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>
    </Border>
</UserControl>