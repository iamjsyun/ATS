<UserControl x:Class="ATSA.UI.UCtrls.UCXTGMsgView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ATSA.UI.UCtrls"
             xmlns:tgmsg="clr-namespace:ATSA.UI.UCtrls.TGMsg"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=local:UCXTGMsgViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="450" d:DesignWidth="400">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!--<Border Background="#F9F9F9" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="5">
            --><!--<StackPanel Orientation="Horizontal">
                <TextBlock Text="CNO " FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CNO}" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text=" Telegram Logs" VerticalAlignment="Center" Margin="5,0,0,0"/>
                <Button Content="Refresh" Command="{Binding RefreshFromDbAsyncCommand}" Margin="10,0,0,0" Padding="5,0"/>
            </StackPanel>--><!--
        </Border>-->

        <ListBox Grid.Row="1" ItemsSource="{Binding Messages}" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <tgmsg:UCXTGMsgView />
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.HorizontalContentAlignment>Stretch</ListBox.HorizontalContentAlignment>
        </ListBox>
    </Grid>
</UserControl>
