<UserControl x:Class="ATSA.UI.DataManager.DataManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             xmlns:local="clr-namespace:ATSA.UI.DataManager"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200">
    
    <UserControl.Resources>
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="InputStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="NumericTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource TextBoxStyle}">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="29"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource Color.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="*"/>    <!-- Content -->
        </Grid.RowDefinitions>

        <!-- 1. Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="{StaticResource Grid.Base}" Padding="{StaticResource Grid.Small}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Command="{Binding AddNewEntrySignalCommand}" Width="120" Margin="{StaticResource Grid.Small}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="New Entry" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveChangesCommand}" Width="140" Margin="{StaticResource Grid.Small}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Save Changes" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <CheckBox IsChecked="{Binding IsForceInject}" 
                              Content="Force Inject" 
                              VerticalAlignment="Center" 
                              Margin="8,0,0,0" 
                              FontSize="11" 
                              Foreground="#888888"/>
                    <Button Command="{Binding LoadSignalsCommand}" Width="140" Margin="{StaticResource Grid.Small}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Command="{Binding UpdateSignalStatusCommand}" CommandParameter="1" Width="120" Margin="{StaticResource Grid.Small}" Background="Red">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Close (1)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding UpdateSignalStatusCommand}" CommandParameter="2" Width="120" Background="#E3F2FD" BorderBrush="#2196F3" Margin="{StaticResource Grid.Small}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE930;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#1976D2"/>
                            <TextBlock Text="Comp (2)" VerticalAlignment="Center" Foreground="#1565C0" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding UpdateSignalStatusCommand}" CommandParameter="3" Width="120" Background="#E3F2FD" BorderBrush="#2196F3" Margin="{StaticResource Grid.Small}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#1976D2"/>
                            <TextBlock Text="Archive (3)" VerticalAlignment="Center" Foreground="#1565C0" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DeleteSelectedSignalCommand}" Width="140" Background="#FFF0F0" Foreground="#FF4B4B" Margin="{StaticResource Grid.Small}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Delete Selected" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DeleteAllSignalsCommand}" Width="140" Background="#4B0000" Foreground="White" Margin="{StaticResource Grid.Small}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE894;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Delete ALL" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Main Layout (Left: Editor, Right: List) -->
        <Grid Grid.Row="1" Margin="{StaticResource Grid.Small}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="550"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Editor Section (Left) -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedSignal}" Margin="4">

                        <!-- Row 1: Identity & Timing -->
                        <StackPanel Margin="0,0,0,3" Orientation="Horizontal">
                            <StackPanel Width="50">
                                <TextBlock Style="{StaticResource HeaderStyle}" Text="CNO" />
                                <ComboBox
                                    ItemsSource="{Binding DataContext.CnoList, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    SelectedValue="{Binding cno}"
                                    Style="{StaticResource InputStyle}" />
                            </StackPanel>
                            <StackPanel Width="80" Margin="2,0,0,0">
                                <TextBlock Style="{StaticResource HeaderStyle}" Text="YYMMDDHH" />
                                <TextBox
                                    Background="#FFFFFF"
                                    Style="{StaticResource TextBoxStyle}"
                                    Text="{Binding yymmddhh}" />
                            </StackPanel>
                            <StackPanel Width="50" Margin="2,0,0,0">
                                <TextBlock Style="{StaticResource HeaderStyle}" Text="SNO" />
                                <ComboBox
                                    ItemsSource="{Binding DataContext.SnoList, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    SelectedValue="{Binding sno}"
                                    Style="{StaticResource InputStyle}" />
                            </StackPanel>
                            <StackPanel Width="50" Margin="2,0,0,0">
                                <TextBlock Style="{StaticResource HeaderStyle}" Text="GNO" />
                                <ComboBox
                                    ItemsSource="{Binding DataContext.GnoList, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    SelectedValue="{Binding gno}"
                                    Style="{StaticResource InputStyle}" />
                            </StackPanel>
                            <StackPanel Width="70" Margin="2,0,0,0">
                                <TextBlock Style="{StaticResource HeaderStyle}" Text="Dir" />
                                <ComboBox
                                    ItemsSource="{Binding DataContext.DirList, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    SelectedItem="{Binding SelectedDir}"
                                    Style="{StaticResource InputStyle}" />
                            </StackPanel>
                            <StackPanel Width="140" Margin="2,0,0,0">
                                <TextBlock Style="{StaticResource HeaderStyle}" Text="Type" />
                                <ComboBox
                                    ItemsSource="{Binding DataContext.TypeList, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    SelectedItem="{Binding SelectedType}"
                                    Style="{StaticResource InputStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Row 2: Symbol, Price, Lot -->
                        <StackPanel Margin="0,0,0,3" Orientation="Horizontal">
                            <StackPanel Width="100">
                                <TextBlock Style="{StaticResource HeaderStyle}" Text="Symbol" />
                                <TextBox Style="{StaticResource TextBoxStyle}" Text="{Binding symbol, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="80" Margin="5,0,0,0">
                                <TextBlock Style="{StaticResource HeaderStyle}" Text="Price" />
                                <TextBox Style="{StaticResource NumericTextBoxStyle}" Text="{Binding price_signal, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" />
                            </StackPanel>
                            <StackPanel Width="60" Margin="5,0,0,0">
                                <TextBlock Style="{StaticResource HeaderStyle}" Text="Lot" />
                                <TextBox Style="{StaticResource NumericTextBoxStyle}" Text="{Binding lot, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" />
                            </StackPanel>

                            <StackPanel Width="120" Margin="5,0,0,0">
                                <TextBlock Style="{StaticResource HeaderStyle}" Text="Lot Type" />
                                <ComboBox
                                    ItemsSource="{Binding DataContext.LotTypeList, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    SelectedItem="{Binding SelectedLotType}"
                                    Style="{StaticResource InputStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Row 3: Trailing & Offset -->
                        <StackPanel Margin="0,0,0,3" Orientation="Horizontal">
                            <StackPanel Width="60">
                                <TextBlock Style="{StaticResource HeaderStyle}" Text="TE Start" />
                                <TextBox Style="{StaticResource NumericTextBoxStyle}" Text="{Binding te_start, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" />
                            </StackPanel>
                            <StackPanel Width="60" Margin="5,0,0,0">
                                <TextBlock Style="{StaticResource HeaderStyle}" Text="TE Step" />
                                <TextBox Style="{StaticResource NumericTextBoxStyle}" Text="{Binding te_step, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" />
                            </StackPanel>
                            <StackPanel Width="80" Margin="5,0,0,0">
                                <TextBlock Style="{StaticResource HeaderStyle}" Text="TE Limit" />
                                <TextBox Style="{StaticResource NumericTextBoxStyle}" Text="{Binding te_limit, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" />
                            </StackPanel>
                            <Button Command="{Binding DataContext.ResetTeSettingsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                    Margin="5,8,0,0" VerticalAlignment="Bottom" Padding="4,2" Background="#E3F2FD" BorderBrush="#2196F3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,2,0" Foreground="#1976D2"/>
                                    <TextBlock Text="Reset" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#1565C0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Row 4: TS & SL/TP -->
                        <StackPanel Margin="0,0,0,3" Orientation="Horizontal">
                            <StackPanel Width="60">
                                <TextBlock Style="{StaticResource HeaderStyle}" Text="TS Start" />
                                <TextBox Style="{StaticResource NumericTextBoxStyle}" Text="{Binding ts_start, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" />
                            </StackPanel>
                            <StackPanel Width="60" Margin="5,0,0,0">
                                <TextBlock Style="{StaticResource HeaderStyle}" Text="TS Step" />
                                <TextBox Style="{StaticResource NumericTextBoxStyle}" Text="{Binding ts_step, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" />
                            </StackPanel>
                            <StackPanel Width="60" Margin="5,0,0,0">
                                <TextBlock Style="{StaticResource HeaderStyle}" Text="SL" />
                                <TextBox Style="{StaticResource NumericTextBoxStyle}" Text="{Binding sl, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" />
                            </StackPanel>
                            <StackPanel Width="60" Margin="5,0,0,0">
                                <TextBlock Style="{StaticResource HeaderStyle}" Text="TP" />
                                <TextBox Style="{StaticResource NumericTextBoxStyle}" Text="{Binding tp, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" />
                            </StackPanel>
                            <Button Command="{Binding DataContext.ResetTsSettingsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                    Margin="5,8,0,0" VerticalAlignment="Bottom" Padding="4,2" Background="#E3F2FD" BorderBrush="#2196F3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,2,0" Foreground="#1976D2"/>
                                    <TextBlock Text="Reset" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#1565C0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Row 5: XA Entry, XA Exit, XE Status -->
                        <StackPanel Margin="0,0,0,3" Orientation="Horizontal">
                            <StackPanel Width="100">
                                <TextBlock Style="{StaticResource HeaderStyle}" Text="XA Entry" />
                                <ComboBox
                                    ItemsSource="{Binding DataContext.XAEntryList, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    SelectedItem="{Binding SelectedXAEntry}"
                                    Style="{StaticResource InputStyle}" />
                            </StackPanel>
                            <StackPanel Width="100" Margin="5,0,0,0">
                                <TextBlock Style="{StaticResource HeaderStyle}" Text="XA Exit" />
                                <ComboBox
                                    ItemsSource="{Binding DataContext.XAExitList, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    SelectedItem="{Binding SelectedXAExit}"
                                    Style="{StaticResource InputStyle}" />
                            </StackPanel>
                            <StackPanel Width="150" Margin="5,0,0,0">
                                <TextBlock Style="{StaticResource HeaderStyle}" Text="XE Status" />
                                <ComboBox
                                    ItemsSource="{Binding DataContext.XEStatusList, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    SelectedItem="{Binding SelectedXEStatus}"
                                    Style="{StaticResource InputStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Row 6: SID, GID, Last Updated -->
                        <StackPanel Margin="0,0,0,3" Orientation="Horizontal">
                            <StackPanel Width="150">
                                <TextBlock Style="{StaticResource HeaderStyle}" Text="SID" />
                                <TextBox Text="{Binding sid}" IsReadOnly="True" Background="#F9F9F9" FontWeight="Bold" Style="{StaticResource TextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Width="100" Margin="5,0,0,0">
                                <TextBlock Style="{StaticResource HeaderStyle}" Text="GID" />
                                <TextBox Text="{Binding gid}" IsReadOnly="True" Background="#F9F9F9" FontWeight="Bold" Style="{StaticResource TextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Width="130" Margin="5,0,0,0">
                                <TextBlock Style="{StaticResource HeaderStyle}" Text="Updated" />
                                <TextBox Text="{Binding updated, StringFormat=HH:mm:ss}" IsReadOnly="True" Background="#F9F9F9" Style="{StaticResource TextBoxStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Separator Margin="0,6"/>

                        <!-- Generated Message Preview -->
                        <TextBox Text="{Binding GeneratedMessage}" 
                                     IsReadOnly="True" 
                                     Background="#F0F7FF" 
                                     MinHeight="100" 
                                     Height="350"
                                     AcceptsReturn="True" 
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     Padding="4"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Grid Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#E0E0E0" />

            <!-- Grid List Section (Right) -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <DockPanel>
                    
                    <DataGrid SelectedItem="{Binding SelectedSignal}"
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              BorderThickness="1"
                              BorderBrush="{StaticResource Color.Border}"
                              SelectionMode="Single"
                              RowHeaderWidth="0"
                              FontSize="11">
                        <!-- [v9.6] 리소스 통합 및 정렬/스타일 정의 -->
                        <DataGrid.Resources>
                            <CollectionViewSource x:Key="SortedSignals" Source="{Binding SignalList}">
                                <CollectionViewSource.SortDescriptions>
                                    <scm:SortDescription PropertyName="sid" Direction="Descending"/>
                                </CollectionViewSource.SortDescriptions>
                            </CollectionViewSource>

                            <!-- 1. 방향별 배경색 구분 적용 (BUY: 연청, SELL: 연적) -->
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding dir}" Value="1">
                                        <Setter Property="Background" Value="#F0F7FF"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding dir}" Value="2">
                                        <Setter Property="Background" Value="#FFF5F5"/>
                                    </DataTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            
                            <!-- 공용 숫자 우측 정렬 스타일 -->
                            <Style x:Key="RightAlignStyle" TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Margin" Value="0,0,4,0"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.ItemsSource>
                            <Binding Source="{StaticResource SortedSignals}"/>
                        </DataGrid.ItemsSource>
                        
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SID" Binding="{Binding sid}" Width="135"/>
                            <DataGridTextColumn Header="Symbol" Binding="{Binding symbol}" Width="60"/>
                            
                            <!-- 2. Dir 코드:코드명 표시 -->
                            <DataGridTextColumn Header="Dir" Binding="{Binding SelectedDir}" Width="55">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding dir}" Value="1"><Setter Property="Foreground" Value="#2196F3"/></DataTrigger>
                                            <DataTrigger Binding="{Binding dir}" Value="2"><Setter Property="Foreground" Value="#F44336"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 3. 숫자 필드 우측 정렬 및 0.00 포맷 적용 -->
                            <DataGridTextColumn Header="Price" Binding="{Binding price_signal, StringFormat=N2}" Width="70" ElementStyle="{StaticResource RightAlignStyle}"/>
                            <DataGridTextColumn Header="Lot" Binding="{Binding lot, StringFormat=N2}" Width="45" ElementStyle="{StaticResource RightAlignStyle}"/>
                            
                            <DataGridTextColumn Header="XA:EN" Binding="{Binding SelectedXAEntry}" Width="65" />
                            <DataGridTextColumn Header="XA:EX" Binding="{Binding SelectedXAExit}" Width="85" />
                            <DataGridTextColumn Header="XE:ST" Binding="{Binding SelectedXEStatus}" Width="85" />
                            
                            <!-- 나머지 정수 포맷 -->
                            <DataGridTextColumn Header="TE" Binding="{Binding te_start, StringFormat=N0}" Width="35" ElementStyle="{StaticResource RightAlignStyle}"/>
                            <DataGridTextColumn Header="TS" Binding="{Binding ts_start, StringFormat=N0}" Width="35" ElementStyle="{StaticResource RightAlignStyle}"/>
                            <DataGridTextColumn Header="SL" Binding="{Binding sl, StringFormat=N0}" Width="50" ElementStyle="{StaticResource RightAlignStyle}"/>
                            <DataGridTextColumn Header="TP" Binding="{Binding tp, StringFormat=N0}" Width="50" ElementStyle="{StaticResource RightAlignStyle}"/>
                            
                            <DataGridTextColumn Header="Status Msg" Binding="{Binding xe_status_msg}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>

</UserControl>
