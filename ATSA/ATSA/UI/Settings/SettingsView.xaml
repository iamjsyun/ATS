<UserControl x:Class="ATSA.UI.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ATSA.UI.Settings"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="{StaticResource Color.Background}">
    
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        

        <Border Grid.Row="1" CornerRadius="8" Background="#1E1E1E" Padding="2">
            <TextBox Text="{Binding JsonText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="16"
                     Background="#2D2D2D"
                     Foreground="#DCDCDC"
                     CaretBrush="White"
                     Padding="5"
                     BorderThickness="0"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Reset Changes" 
                    Command="{Binding ResetCommand}"
                    Width="140" Height="40" 
                    Margin="0,0,12,0"
                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                    Background="#3E3E42" Foreground="White"/>
            
            <Button Content="Save &amp; Apply Hot-Reload" 
                    Command="{Binding SaveAndApplyCommand}"
                    Width="220" Height="40" 
                    Background="#007ACC" Foreground="White" FontWeight="Bold" FontSize="14"/>
        </StackPanel>
    </Grid>
</UserControl>
