# Auto detect text files and perform LF normalization
* text=auto

# Source files - Force CRLF for Windows development (C# & MQL5)
*.cs     text eol=crlf
*.xaml   text eol=crlf
*.mq5    text eol=crlf
*.mqh    text eol=crlf
*.sln    text eol=crlf
*.csproj text eol=crlf
*.json   text eol=crlf
*.md     text eol=crlf
*.xml    text eol=crlf

# Binary files
*.ex5    binary
*.exe    binary
*.dll    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.ico    binary
*.pdf    binary
